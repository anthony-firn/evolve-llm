{
  "name": "evolve-llm",
  "version": "0.2.0",
  "private": true,
  "description": "Run GGUF language models on your GPU from a web page with a Rust WebGPU engine compiled to WebAssembly.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "python3 tools/build_web.py",
    "serve": "python3 -m http.server 8080 --directory dist",
    "typecheck": "tsc --noEmit --strict --target es2022 --module nodenext --lib es2023,dom tests/sdk-types.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
